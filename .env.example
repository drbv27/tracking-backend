# Metrics Lab - Environment Variables Template
# Copy this file to .env and fill in your actual values

# ============================================================================
# ENVIRONMENT
# ============================================================================
NODE_ENV=production

# ============================================================================
# SERVER CONFIGURATION
# ============================================================================
PORT=3000

# ============================================================================
# DATABASE
# ============================================================================
# MongoDB connection string
# Get this from MongoDB Atlas: https://cloud.mongodb.com/
# Format: mongodb+srv://username:password@cluster.mongodb.net/database_name
MONGODB_URI=mongodb+srv://your_username:your_password@your_cluster.mongodb.net/metrics_lab?retryWrites=true&w=majority

# ============================================================================
# AUTHENTICATION
# ============================================================================
# Secret key for JWT token generation
# Generate a random string: openssl rand -base64 32
JWT_SECRET=your_super_secret_jwt_key_here_change_this_in_production

# ============================================================================
# FRONTEND URL (for CORS)
# ============================================================================
# URL of your frontend dashboard (if different from backend)
# FRONTEND_URL=https://dashboard.yourdomain.com

# ============================================================================
# NOTES FOR HOSTINGER DEPLOYMENT
# ============================================================================
# 
# When deploying to Hostinger, make sure to set these environment variables
# in your hosting panel or via SSH:
#
# 1. NODE_ENV=production
# 2. MONGODB_URI=your_actual_mongodb_connection_string
# 3. JWT_SECRET=your_actual_secret_key
# 4. PORT=3000 (or whatever port Hostinger assigns)
#
# DO NOT commit your actual .env file to GitHub!
# Keep your secrets safe!
#
